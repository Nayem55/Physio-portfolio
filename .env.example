# Copy this file to `.env` and fill in the values.

# Public address of the site (no trailing slash). Used for SEO links and the sitemap.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Long random string used to sign dashboard logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# MongoDB database used by Payload CMS and the Express API.
MONGODB_URI=mongodb://127.0.0.1:27017/physio-portfolio

# --- Email for appointment requests (optional) --------------------------------
# Without SMTP_HOST, requests are still saved in the dashboard and emails are only
# printed to the server log. Gmail: smtp.gmail.com, port 465, and an App Password
# (Google Account → Security → App passwords), not the normal Gmail password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Abdullah Shuchorit Website

# Fallback recipient if "Send form requests to" is empty in the dashboard
# (Contact & Appointment → Appointment form). Otherwise the contact email is used.
CONTACT_NOTIFICATION_EMAIL=
